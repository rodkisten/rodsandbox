{
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@8.15.9",
  "pnpm": {
    "neverBuiltDependencies": [
      "node-pty"
    ]
  },
  "name": "rodsandbox",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "predev": "node scripts/generate-typescript-libs.mjs",
    "prebuild": "node scripts/generate-typescript-libs.mjs",
    "typecheck": "tsc --noEmit",
    "build:browser": "node scripts/generate-typescript-libs.mjs && vite build",
    "dev:browser": "node scripts/generate-typescript-libs.mjs && vite",
    "build:module": "node scripts/generate-typescript-libs.mjs && vite build --mode federation && node scripts/package-module.mjs"
  },
