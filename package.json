    "idb": "^8.0.3",
    "isomorphic-git": "^1.38.3",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-pwa": "^5.6.0",
    "node-pty": "^1.1.0",
    "prettier": "^3.8.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
